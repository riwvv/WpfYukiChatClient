<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:WpfYukiChatClient.Converters">
    <Style x:Key="MainGridStyle" TargetType="Grid">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush>
                    <GradientStop Color="{StaticResource Color3}" Offset="0"/>
                    <GradientStop Color="{StaticResource Color1}" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BrInputStyle" TargetType="Border">
        <Setter Property="MinHeight" Value="75"/>
        <Setter Property="Background">
            <Setter.Value>
                <DrawingBrush TileMode="Tile"
                          Stretch="None"
                          Viewport="0 0 30 30" ViewportUnits="Absolute"
                          Viewbox="0 0 30 43" ViewboxUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <DrawingGroup>
                            <GeometryDrawing Brush="{StaticResource Brush2}">
                                <GeometryDrawing.Geometry>
                                    <RectangleGeometry Rect="0,0 50,50"/>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                            <GeometryDrawing Brush="{StaticResource DotGridBrush}">
                                <GeometryDrawing.Geometry>
                                    <RectangleGeometry Rect="0,0 50,50"/>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingGroup>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Margin" Value="15"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush4}"/>
        <Setter Property="BorderThickness" Value="5"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect ShadowDepth="0" Color="{DynamicResource Color5}" BlurRadius="30"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TbStyle" TargetType="TextBox">
        <Setter Property="Background">
            <Setter.Value>
                <DrawingBrush TileMode="Tile"
                          Stretch="None"
                          Viewport="0 0 30 30" ViewportUnits="Absolute"
                          Viewbox="0 0 30 43" ViewboxUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <DrawingGroup>
                            <GeometryDrawing Brush="{StaticResource Brush2}">
                                <GeometryDrawing.Geometry>
                                    <RectangleGeometry Rect="0,0 50,50"/>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                            <GeometryDrawing Brush="{StaticResource DotGridBrush}">
                                <GeometryDrawing.Geometry>
                                    <RectangleGeometry Rect="0,0 50,50"/>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingGroup>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="{StaticResource Brush6}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontFamily" Value="Arial"/>
        <Setter Property="CaretBrush" Value="{StaticResource Brush6}"/>
        <Setter Property="Padding" Value="15 10"/>
        <Setter Property="MinHeight" Value="75"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush5}"/>
        <Setter Property="BorderThickness" Value="5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="15">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Brush6}"/>
                            <Setter TargetName="border" Property="BorderThickness" Value="3"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Brush1}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect ShadowDepth="0" Color="{DynamicResource Color5}" BlurRadius="30"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TbUsernameStyle" TargetType="TextBox">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Brush6}"/>
        <Setter Property="FontFamily" Value="Arial"/>
        <Setter Property="CaretBrush" Value="{StaticResource Brush6}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Padding" Value="10 2"/>
        <Setter Property="Margin" Value="5"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="MinWidth" Value="150"/>
        <Setter Property="MaxWidth" Value="500"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush4}"/>
        <Setter Property="Background" Value="{StaticResource Brush2}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>

                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="0" Color="{DynamicResource Color5}" BlurRadius="15"/>
                        </Border.Effect>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LbTitleStyle" TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource Brush6}"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontFamily" Value="Arial"/>
        <Setter Property="Margin" Value="15 10"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect ShadowDepth="0" Color="{DynamicResource Color5}" BlurRadius="15"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LbClueStyle" TargetType="Label">
        <Setter Property="Content" Value="Enter - перенести строку | Ctrl + Enter - отправить"/>
        <Setter Property="Foreground" Value="{StaticResource Brush5}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontFamily" Value="Candara Light"/>
        <Setter Property="Margin" Value="30 2"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect ShadowDepth="0" Color="{DynamicResource Color5}" BlurRadius="15"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TblReceivedMessageStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontFamily" Value="Calibri Light"/>
        <Setter Property="Foreground" Value="{StaticResource Brush1}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="MaxWidth" Value="1000"/>
    </Style>

    <Style x:Key="TblSentMessageStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontFamily" Value="Calibri Light"/>
        <Setter Property="Foreground" Value="{StaticResource Brush6}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="MaxWidth" Value="1000"/>
    </Style>

    <ItemsPanelTemplate x:Key="ChatItemsPanel">
        <VirtualizingStackPanel VerticalAlignment="Bottom"/>
    </ItemsPanelTemplate>

    <DataTemplate x:Key="SentTemplate">
        <Border Background="{StaticResource Brush3}"
                BorderBrush="{StaticResource Brush5}"
                BorderThickness="3"
                CornerRadius="5" 
                Padding="8" 
                Margin="50,5,5,5" 
                HorizontalAlignment="Right">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource TblSentMessageStyle}" Text="{Binding Username}"/>
                <TextBlock Style="{StaticResource TblSentMessageStyle}" Margin="5 0" Text=" >> "/>
                <TextBlock Style="{StaticResource TblSentMessageStyle}" Margin="0 0 10 0" Text="{Binding Text}" TextWrapping="Wrap"/>
                <TextBlock Style="{StaticResource TblSentMessageStyle}" FontSize="12" VerticalAlignment="Bottom" Text="{Binding ReceiptTime}"/>
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="ReceivedTemplate">
        <Border Background="{StaticResource Brush6}"
                BorderBrush="{StaticResource Brush5}"
                BorderThickness="3"
                CornerRadius="5" 
                Padding="8" 
                Margin="5,5,50,5" 
                HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource TblReceivedMessageStyle}" Text="{Binding Username}"/>
                <TextBlock Style="{StaticResource TblReceivedMessageStyle}" Margin="5 0" Text=" >> "/>
                <TextBlock Style="{StaticResource TblReceivedMessageStyle}" Margin="0 0 10 0" Text="{Binding Text}" TextWrapping="Wrap"/>
                <TextBlock Style="{StaticResource TblReceivedMessageStyle}" FontSize="12" VerticalAlignment="Bottom" Text="{Binding ReceiptTime}"/>
            </StackPanel>
        </Border>
    </DataTemplate>
    
    <local:MessageTemplateSelector x:Key="MyMessageTemplateSelector"
            SentMessageTemplate="{StaticResource SentTemplate}"
            ReceivedMessageTemplate="{StaticResource ReceivedTemplate}"/>


    <Style x:Key="ChatItemStyle" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0 4"/>
        <Setter Property="Margin" Value="10 0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style x:Key="LbChatStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
    </Style>

    <Style x:Key="BtnStyle" TargetType="Button">
        <Setter Property="Margin" Value="5"/>
        <Setter Property="Padding" Value="10 5"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Foreground" Value="{StaticResource Brush6}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Background">
            <Setter.Value>
                <DrawingBrush TileMode="Tile"
                              Stretch="None"
                              Viewport="0 0 50 50" ViewportUnits="Absolute"
                              Viewbox="0 0 50 50" ViewboxUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <DrawingGroup>
                            <GeometryDrawing Brush="{StaticResource Brush2}">
                                <GeometryDrawing.Geometry>
                                    <RectangleGeometry Rect="0 0 50 50"/>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                            <GeometryDrawing Brush="{StaticResource DotGridForBtnBrush}">
                                <GeometryDrawing.Geometry>
                                    <RectangleGeometry Rect="0 0 50 50"/>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingGroup>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            Margin="{TemplateBinding Margin}"
                            Padding="{TemplateBinding Padding}"
                            BorderThickness="2"
                            BorderBrush="{StaticResource Brush4}"
                            CornerRadius="2">
                        <ContentPresenter VerticalAlignment="Center"
                                          HorizontalAlignment="Center">
                        </ContentPresenter>

                        <Border.Effect>
                            <DropShadowEffect Color="{StaticResource Color5}" BlurRadius="15" ShadowDepth="0"/>
                        </Border.Effect>
                    </Border>
                    
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource Brush3}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource Brush5}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource Brush6}"/>
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="{StaticResource Color6}" BlurRadius="5" ShadowDepth="0"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>