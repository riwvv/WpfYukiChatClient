<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Brush1" Color="#00030E"/>
    <SolidColorBrush x:Key="Brush2" Color="#0B0E1A"/>
    <SolidColorBrush x:Key="Brush3" Color="#2C1B2F"/>
    <SolidColorBrush x:Key="Brush4" Color="#5E3A5C"/>
    <SolidColorBrush x:Key="Brush5" Color="#B47A9A"/>
    <SolidColorBrush x:Key="Brush6" Color="#F3E9EC"/>

    <Color x:Key="Color1">#00030E</Color>
    <Color x:Key="Color2">#0B0E1A</Color>
    <Color x:Key="Color3">#2C1B2F</Color>
    <Color x:Key="Color4">#5E3A5C</Color>
    <Color x:Key="Color5">#B47A9A</Color>
    <Color x:Key="Color6">#F3E9EC</Color>

    <VisualBrush x:Key="DotGridBrush"
             TileMode="Tile"
             Viewport="0 0 30 30" ViewportUnits="Absolute"
             Viewbox="0 0 50 50" ViewboxUnits="Absolute">
        <VisualBrush.Visual>
            <Ellipse Width="2" Height="2" Fill="{StaticResource Brush6}"/>
        </VisualBrush.Visual>
    </VisualBrush>

    <VisualBrush x:Key="DotGridForBtnBrush"
         TileMode="Tile"
         Viewport="6 10 12 12" ViewportUnits="Absolute"
         Viewbox="0 0 50 50" ViewboxUnits="Absolute">
        <VisualBrush.Visual>
            <Ellipse Width="2" Height="2" Fill="{StaticResource Brush6}"/>
        </VisualBrush.Visual>
    </VisualBrush>

    <VisualBrush x:Key="ScreenLineBrush"
             TileMode="Tile"
             Viewport="0 0 8 1"
             ViewportUnits="Absolute"
             Viewbox="0 0 8 1"
             ViewboxUnits="Absolute">
        <VisualBrush.Visual>
            <Path Stroke="{StaticResource Brush2}"
              StrokeThickness="2"
              Opacity="0.3"
              Margin="7 0 0 0">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure StartPoint="0 0" IsClosed="False">
                            <BezierSegment Point1="0 0" Point2="0 70"/>
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
                <Path.Effect>
                    <DropShadowEffect Color="{StaticResource Color3}" BlurRadius="7" ShadowDepth="0"/>
                </Path.Effect>
            </Path>
        </VisualBrush.Visual>
    </VisualBrush>
</ResourceDictionary>